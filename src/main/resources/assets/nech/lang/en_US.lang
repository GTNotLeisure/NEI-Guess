# NEI-native option labels
nei.options.nech=Phonetic Search - Rework
nei.options.nech.tip=Configure phonetic matching through native NEI settings.
nei.options.nech.pinyin=Enable pinyin search
nei.options.nech.pinyin.tip=Toggle full pinyin, initials and fuzzy phonetic matching immediately. Literal search, word-list aliases and Lua settings remain independent
nei.options.nech.pinyin.true=Enable
nei.options.nech.pinyin.false=Disable
nei.options.nech.ignore_comma=Ignore commas when matching
nei.options.nech.ignore_comma.tip=Remove commas from candidate text before phonetic matching.
nei.options.nech.ignore_comma.true=Yes
nei.options.nech.ignore_comma.false=No
nei.options.nech.parentheses=Ignore parentheses when matching
nei.options.nech.parentheses.tip=Remove round parentheses from candidate text before phonetic matching.
nei.options.nech.parentheses.true=Yes
nei.options.nech.parentheses.false=No
nei.options.nech.contain_with_voltage=Split voltage prefixes when matching
nei.options.nech.contain_with_voltage.tip=Match a voltage prefix and the remaining text separately, for example hvpump.
nei.options.nech.contain_with_voltage.true=Yes
nei.options.nech.contain_with_voltage.false=No
nei.options.nech.lua_script=Enable custom Lua search scripts
nei.options.nech.lua_script.tip=Apply enabled scripts from the pinin directory to search text and input.
nei.options.nech.lua_script.true=Yes
nei.options.nech.lua_script.false=No
nei.options.nech.lua_scripts=Lua scripts
nei.options.nech.lua_scripts.tip=Enable individual scripts; use /nech reload after editing their files.

# Shared option states
nech.state.enabled=Enabled
nech.state.disabled=Disabled

